{
  "name": "elyshield-mcp",
  "version": "0.1.4",
  "description": "ElyShield MCP server \u2014 post-quantum file encryption for AI agents. Hybrid ML-KEM-768 + X25519, ML-DSA-65 signatures, AES-256-GCM. Runs fully local over stdio: keys never leave the machine.",
  "type": "module",
  "bin": {
    "elyshield-mcp": "dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/server.ts",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@elyshield/core": "file:../core"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "post-quantum",
    "ml-kem",
    "ml-dsa",
    "kyber",
    "dilithium",
    "encryption",
    "cryptography",
    "ai-agents",
    "elysium",
    "elyshield",
    "quantum-safe"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elyshield/elyshield.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://elyshield.xyz",
  "bugs": {
    "url": "https://github.com/elyshield/elyshield/issues"
  },
  "author": "ElyShield",
  "publishConfig": {
    "access": "public"
  },
  "_comment_bundled": "@elyshield/core is bundled into dist/server.js by tsup (noExternal). It is a devDependency only \u2014 publishing a file: reference would produce a package that installs and then crashes."
}
